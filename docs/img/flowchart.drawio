<mxfile host="pillscale" version="24.0.0"><diagram id="flow" name="Блок-схема работы весов"><mxGraphModel dx="1200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="Включение весов" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="160" height="44" as="geometry"/></mxCell><mxCell id="init" value="Загрузить калибровку и выученные виды доз;&lt;br&gt;журнал: «включение»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="94" width="300" height="60" as="geometry"/></mxCell><mxCell id="net" value="Сеть: 30 с пытаться подключиться&lt;br&gt;к домашнему Wi-Fi, иначе своя точка доступа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="184" width="300" height="60" as="geometry"/></mxCell><mxCell id="wait" value="На платформе&lt;br&gt;больше 2 г,&lt;br&gt;вес спокоен?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="274" width="220" height="100" as="geometry"/></mxCell><mxCell id="placed" value="Коробка стоит: запомнить её вес (базу);&lt;br&gt;журнал: «поставили»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="404" width="300" height="60" as="geometry"/></mxCell><mxCell id="lifted" value="Коробку сняли?&lt;br&gt;(вес упал ниже&lt;br&gt;половины)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="500" width="220" height="110" as="geometry"/></mxCell><mxCell id="changed" value="Вес изменился&lt;br&gt;на 35 мг и больше&lt;br&gt;и установился?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="650" width="220" height="110" as="geometry"/></mxCell><mxCell id="track" value="Подстроить базу&lt;br&gt;под медленный дрейф" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="180" height="70" as="geometry"/></mxCell><mxCell id="d_inplace" value="Δ = новый вес − прежний" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="800" width="260" height="50" as="geometry"/></mxCell><mxCell id="removed" value="Журнал: «сняли».&lt;br&gt;R1 — вес коробки до,&lt;br&gt;Z1 — ноль пустой платформы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="515" width="280" height="80" as="geometry"/></mxCell><mxCell id="back" value="Коробку&lt;br&gt;вернули?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="long" value="Коробки нет&lt;br&gt;больше 8,5 мин?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="640" width="200" height="100" as="geometry"/></mxCell><mxCell id="missing" value="Журнал: «нет коробки»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="780" width="180" height="50" as="geometry"/></mxCell><mxCell id="r2" value="Z2 — ноль прямо перед возвратом;&lt;br&gt;подождать 3 с, R2 — вес после" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="280" height="70" as="geometry"/></mxCell><mxCell id="d_lift" value="Δ = (R2 − Z2) − (R1 − Z1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="880" width="280" height="50" as="geometry"/></mxCell><mxCell id="newbox_q" value="|Δ| больше половины&lt;br&gt;веса коробки?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="980" width="220" height="110" as="geometry"/></mxCell><mxCell id="none_q" value="|Δ| меньше&lt;br&gt;35 мг?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="985" width="200" height="100" as="geometry"/></mxCell><mxCell id="refill_q" value="Δ больше нуля?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="985" width="200" height="100" as="geometry"/></mxCell><mxCell id="newbox" value="Другая коробка:&lt;br&gt;новая база" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="1130" width="200" height="60" as="geometry"/></mxCell><mxCell id="none" value="Ничего не взяли" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="1130" width="200" height="60" as="geometry"/></mxCell><mxCell id="refill" value="Пополнение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="1130" width="200" height="60" as="geometry"/></mxCell><mxCell id="dose" value="Доза: совпала с выученным видом —&lt;br&gt;вид подтверждён, иначе — новый вид" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="995" width="240" height="80" as="geometry"/></mxCell><mxCell id="journal" value="Запись в журнал: событие, Δ, время" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="1240" width="970" height="60" as="geometry"/></mxCell><mxCell id="note" value="Каждый ромб проверяется по очередному блоку отсчётов (около 1 с). Пока коробку трогают, блоки «неспокойные» и пропускаются, поэтому рука и толчки не дают ложных событий.&lt;br&gt;&lt;br&gt;Метод двух нулей: R1 и R2 сравниваются каждый со свежим нулём пустой платформы, поэтому дрейф за время, пока коробки нет, вычитается." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="94" width="520" height="150" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="start" target="init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="init" target="net"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="net" target="wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="нет — ждать" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wait" target="wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="324"/><mxPoint x="150" y="259"/><mxPoint x="360" y="259"/></Array></mxGeometry></mxCell><mxCell id="e5" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wait" target="placed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="placed" target="lifted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lifted" target="removed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=12;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent